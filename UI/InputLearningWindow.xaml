<Window x:Class="MonitorSwitch.Views.InputLearningWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="学习输入源" Width="520" SizeToContent="Height" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="学习输入源" Style="{StaticResource PageTitle}"/><TextBlock Grid.Row="1" Text="{Binding DisplayTitle}" Style="{StaticResource SecondaryText}" Margin="0,4,0,18"/><Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="DisplayPort" Style="{StaticResource BodyText}"/><TextBlock Grid.Column="1" Text="{Binding DisplayPortMapping}" Style="{StaticResource SecondaryText}"/><Button Grid.Column="2" Content="学习" Command="{Binding LearnDisplayPortCommand}" Style="{StaticResource CompactButton}"/></Grid><Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Type-C" Style="{StaticResource BodyText}"/><TextBlock Grid.Column="1" Text="{Binding UsbCMapping}" Style="{StaticResource SecondaryText}"/><Button Grid.Column="2" Content="学习" Command="{Binding LearnUsbCCommand}" Style="{StaticResource CompactButton}"/></Grid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="HDMI" Style="{StaticResource BodyText}"/><TextBlock Grid.Column="1" Text="{Binding HdmiMapping}" Style="{StaticResource SecondaryText}"/><Button Grid.Column="2" Content="学习" Command="{Binding LearnHdmiCommand}" Style="{StaticResource CompactButton}"/></Grid></Grid><TextBlock Grid.Row="3" Text="请先手动切换到目标输入源，再读取当前值并保存标签。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,16"/><StackPanel Grid.Row="4" Orientation="Horizontal"><Button Content="恢复默认映射" Command="{Binding ResetMappingCommand}" Style="{StaticResource GhostButton}"/><Button Content="关闭" IsCancel="True" Style="{StaticResource CompactButton}" Margin="8,0,0,0"/></StackPanel></Grid>
</Window>
