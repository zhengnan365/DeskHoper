<Window x:Class="MonitorSwitch.Views.ProfileEditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{Binding WindowTitle}" Width="520" SizeToContent="Height" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
  <StackPanel Margin="24">
    <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="取一个名字，下面选好的输入源和投影模式会一起绑到这个按钮上。" Style="{StaticResource SecondaryText}" Margin="0,4,0,18" TextWrapping="Wrap"/>
    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="按钮名称" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
      <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InlineRenameTextBox}" Height="34"/>
    </Grid>
    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="每台显示器切到哪个输入源" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="读取当前输入源" Command="{Binding UseCurrentInputsCommand}" Style="{StaticResource CompactButton}" Height="30"/></Grid>
    <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,0,18">
      <ItemsControl.ItemTemplate><DataTemplate>
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" DisplayMemberPath="Label" Height="32" VerticalContentAlignment="Center"/>
        </Grid>
      </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <Grid Margin="0,0,0,22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="投影模式" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
      <ComboBox Grid.Column="1" ItemsSource="{Binding ProjectionOptions}" SelectedItem="{Binding SelectedProjection}" DisplayMemberPath="Label" Height="32" VerticalContentAlignment="Center"/>
    </Grid>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消" IsCancel="True" Style="{StaticResource CompactButton}" Width="88" Height="36" Margin="0,0,8,0"/>
      <Button Content="保存" x:Name="SaveButton" IsDefault="True" Style="{StaticResource CompactButton}" Width="88" Height="36" FontWeight="SemiBold" Click="Save_Click" IsEnabled="{Binding CanSave}"/>
    </StackPanel>
  </StackPanel>
</Window>
