<Window x:Class="MonitorSwitch.Views.CloseChoiceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DeskHoper" Width="404" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" Background="{StaticResource BackgroundBrush}">
  <StackPanel Margin="24,20,24,20">
    <TextBlock Text="关闭 DeskHoper 时怎么办？" Style="{StaticResource PageTitle}" Margin="0,0,0,12"/>
    <TextBlock Text="隐藏到托盘：窗口收起来，剪贴板同步、文件共享和热键继续工作，托盘图标单击唤回。" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
    <TextBlock Text="退出程序：共享和热键全部停止。" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,18"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="退出程序" Click="Exit_Click" Style="{StaticResource CompactButton}" Width="96" Height="36" Margin="0,0,10,0"/>
      <Button Content="隐藏到托盘" Click="Tray_Click" Style="{StaticResource AccentButton}" Width="104" Height="36" FontWeight="SemiBold"/>
    </StackPanel>
    <CheckBox x:Name="RememberCheck" Content="记住我的选择，下次不再问" Margin="0,16,0,0"/>
  </StackPanel>
</Window>
