<Window x:Class="MonitorSwitch.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DeskHoper 设置" Width="760" MinWidth="680" SizeToContent="Height" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,22"><TextBlock Text="设置" Style="{StaticResource PageTitle}"/><TextBlock Text="管理显示器、场景与诊断" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/></StackPanel>
    <GroupBox Grid.Row="1" Header="显示器" Padding="16" Margin="0,0,0,14"><StackPanel><ItemsControl ItemsSource="{Binding Monitors}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayTitle}" Style="{StaticResource BodyText}"/><TextBlock Text="{Binding ModelSubtitle}" Style="{StaticResource CaptionText}" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding DdcStatus}" Style="{StaticResource SecondaryText}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="输入源学习可从主界面显示器卡片打开。" Style="{StaticResource CaptionText}"/></StackPanel></GroupBox>
    <GroupBox Grid.Row="2" Header="场景与快捷键" Padding="16" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ItemsControl ItemsSource="{Binding Profiles}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyText}" Margin="0,0,0,12"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ItemsControl Grid.Column="1" ItemsSource="{Binding Profiles}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding ShortcutDisplayText}" Style="{StaticResource BodyText}" HorizontalAlignment="Right" Margin="0,0,0,12"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></GroupBox>
    <GroupBox Grid.Row="3" Header="高级 / 诊断" Padding="16"><StackPanel><TextBlock Text="Stable ID、Serial Number、DevicePath、Windows Display Name、当前 VCP 与 Projection topology" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding Monitors}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Id}" Style="{StaticResource CaptionText}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="测试 DDC" Command="{Binding TestDdcCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/><Button Content="打开日志目录" Command="{Binding OpenLogsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/><Button Content="保存设置" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></GroupBox>
  </Grid></ScrollViewer>
</Window>
