<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="ColorBackground">#F5F7FA</Color><Color x:Key="ColorSurface">#FFFFFF</Color><Color x:Key="ColorSurfaceSecondary">#EEF2F7</Color><Color x:Key="ColorBorder">#D9E0EA</Color><Color x:Key="ColorTextPrimary">#172033</Color><Color x:Key="ColorTextSecondary">#536176</Color><Color x:Key="ColorTextTertiary">#718096</Color><Color x:Key="ColorAccent">#0F6CBD</Color><Color x:Key="ColorAccentHover">#115EA3</Color><Color x:Key="ColorAccentSoft">#E6F1FB</Color><Color x:Key="ColorSuccess">#107C10</Color><Color x:Key="ColorSuccessSoft">#E7F4E7</Color>
  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource ColorBackground}"/><SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}"/><SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{StaticResource ColorSurfaceSecondary}"/><SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorder}"/><SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorTextPrimary}"/><SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}"/><SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource ColorTextTertiary}"/><SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorAccent}"/><SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource ColorAccentHover}"/><SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource ColorAccentSoft}"/><SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}"/><SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource ColorSuccessSoft}"/>
</ResourceDictionary>
