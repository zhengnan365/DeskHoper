<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="SurfaceCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius8}"/>
    <Setter Property="Padding" Value="{StaticResource Space20}"/>
  </Style>
  <Style x:Key="ProfileCard" TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
    <Setter Property="Padding" Value="16,12"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius8}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="BorderThickness" Value="1.5"/><Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="MonitorCard" TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
    <Setter Property="Padding" Value="18,8,18,14"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius8}"/>
    <Setter Property="ClipToBounds" Value="False"/>
  </Style>
</ResourceDictionary>
