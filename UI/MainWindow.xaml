<Window x:Class="MonitorSwitch.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MonitorSwitcher" Width="516" MinWidth="516" MaxWidth="516" SizeToContent="Height" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}">
  <Window.Resources><Style x:Key="NavTab" TargetType="Button"><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="2,7"/><Setter Property="Margin" Value="0,0,28,0"/><Setter Property="MinHeight" Value="36"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid Background="Transparent"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="2"/></Grid.RowDefinitions><ContentPresenter Grid.Row="0" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/><Border Grid.Row="1" CornerRadius="1,1,0,0" Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style><CollectionViewSource x:Key="ExternalMonitorsView" Source="{Binding Monitors}" Filter="ExternalMonitorFilter"/></Window.Resources>
  <Grid Margin="16,24,16,24" HorizontalAlignment="Stretch">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,18" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="MonitorSwitcher" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding DisplayStatusText, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="240"/></Grid>
    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,15">
      <StackPanel Orientation="Horizontal">
        <Button Content="屏幕切换" Command="{Binding SelectSectionCommand}" CommandParameter="ScreenSwitch"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavTab}"><Style.Triggers><DataTrigger Binding="{Binding ActiveSection}" Value="ScreenSwitch"><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Tag" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
        <Button Content="文件共享" Command="{Binding SelectSectionCommand}" CommandParameter="Sharing"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavTab}"><Style.Triggers><DataTrigger Binding="{Binding ActiveSection}" Value="Sharing"><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Tag" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
        <Button Content="键鼠共享" Command="{Binding SelectSectionCommand}" CommandParameter="KeyboardMouse"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavTab}"><Style.Triggers><DataTrigger Binding="{Binding ActiveSection}" Value="KeyboardMouse"><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Tag" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
      </StackPanel>
    </Border>
    <Grid Grid.Row="2">
      <StackPanel>
        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ActiveSection}" Value="ScreenSwitch"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="快速切换" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
      <ItemsControl ItemsSource="{Binding Profiles}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
          <Border Style="{StaticResource ProfileCard}" Height="84" Margin="0,0,8,0">
            <Border.ContextMenu><ContextMenu><MenuItem Header="保存当前配置" Command="{Binding PlacementTarget.DataContext.SaveCurrentInputsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/><MenuItem Header="重命名" Command="{Binding PlacementTarget.DataContext.BeginRenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/></ContextMenu></Border.ContextMenu>
            <Grid VerticalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" MouseLeftButtonDown="ProfileName_MouseLeftButtonDown"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ProfileTitle}"><Style.Triggers><DataTrigger Binding="{Binding IsEditingName}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Ellipse Width="10" Height="10" Fill="{StaticResource SuccessBrush}" Margin="8,0,0,0" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsEditingName}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse></StackPanel>
              <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding EditableName, UpdateSourceTrigger=PropertyChanged}" KeyDown="ProfileNameEditor_KeyDown" LostFocus="ProfileNameEditor_LostFocus"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource InlineRenameTextBox}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEditingName}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
              <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding Converter={StaticResource ProfileConnectionSummaryConverter}}" Style="{StaticResource SecondaryText}"/></StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsEditingName}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Button Content="✓" Command="{Binding CommitRenameCommand}" Style="{StaticResource InlineRenameConfirmButton}"/><Button Content="×" Command="{Binding CancelRenameCommand}" Style="{StaticResource InlineRenameCancelButton}" Margin="4,0,0,0"/></StackPanel>
              <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Content="切换" Command="{Binding SwitchCommand}" Style="{StaticResource ProfileActionButton}" Width="76" Height="36" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>    <StackPanel Grid.Row="2" Margin="0,0,0,13"><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="显示器控制" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="刷新" Command="{Binding RefreshMonitorsCommand}" Style="{StaticResource CompactButton}" Width="48" Height="30" Margin="16,0,0,0" VerticalAlignment="Center"/><Button Grid.Column="2" Content="标识" Command="{Binding IdentifyMonitorsCommand}" Style="{StaticResource CompactButton}" Width="48" Height="30" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid><ItemsControl ItemsSource="{Binding Source={StaticResource ExternalMonitorsView}}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource MonitorCard}" Width="460" HorizontalAlignment="Stretch" MinHeight="0" Margin="0,0,0,16" AllowDrop="True" Drop="MonitorCard_Drop"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MouseLeftButtonDown="MonitorName_MouseLeftButtonDown" PreviewMouseMove="MonitorTitle_PreviewMouseMove"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}"><Setter Property="Text" Value="内置显示器"/><Style.Triggers><DataTrigger Binding="{Binding IsDdcSupported}" Value="True"><Setter Property="Text" Value="{Binding DisplayTitle}"/></DataTrigger><DataTrigger Binding="{Binding IsEditingName}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBox Grid.Column="0" Text="{Binding EditableName, UpdateSourceTrigger=PropertyChanged}" KeyDown="MonitorNameEditor_KeyDown" LostFocus="MonitorNameEditor_LostFocus"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource InlineRenameTextBox}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEditingName}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox><TextBlock Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}"><Setter Property="Text" Value="DDC不可用"/><Style.Triggers><DataTrigger Binding="{Binding IsDdcSupported}" Value="True"><Setter Property="Text" Value="DDC可用"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><StackPanel Grid.Column="2" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsEditingName}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Button Content="✓" Command="{Binding CommitRenameCommand}" Style="{StaticResource InlineRenameConfirmButton}"/><Button Content="×" Command="{Binding CancelRenameCommand}" Style="{StaticResource InlineRenameCancelButton}" Margin="4,0,0,0"/></StackPanel><Border Grid.Column="3" Width="30" Height="30" Background="{StaticResource AccentSoftBrush}" CornerRadius="8" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayNumber}" Style="{StaticResource CaptionText}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid><Grid Grid.Row="1" Margin="0,4,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}"><Setter Property="Text" Value="{Binding DisplayTitle}"/><Style.Triggers><DataTrigger Binding="{Binding IsDdcSupported}" Value="True"><Setter Property="Text" Value="{Binding ModelSubtitle}"/></DataTrigger><DataTrigger Binding="{Binding ModelSubtitle}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Grid.Column="1" Text="当前输入源" Style="{StaticResource SecondaryText}" Margin="18,0,0,0"/><TextBlock Grid.Column="2" Margin="8,0,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}"><Setter Property="Text" Value="系统内置"/><Style.Triggers><DataTrigger Binding="{Binding IsDdcSupported}" Value="True"><Setter Property="Text" Value="{Binding InputDisplayName}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><StackPanel Grid.Row="3" Orientation="Horizontal" Visibility="Visible"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsDdcSupported}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Button Content="学习输入源" Click="LearnInput_Click" Style="{StaticResource LearnButton}" Width="108" Height="34"/><Button Content="DP" Command="{Binding SwitchToDisplayPortCommand}" Margin="8,0,0,0" IsEnabled="{Binding CanSwitchToDisplayPort}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource InputSourceButton}"><Style.Triggers><DataTrigger Binding="{Binding InputDisplayName}" Value="DisplayPort"><Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="Type-C" Command="{Binding SwitchToUsbCCommand}" Margin="8,0,0,0" IsEnabled="{Binding CanSwitchToUsbC}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource InputSourceButton}"><Setter Property="Width" Value="80"/><Style.Triggers><DataTrigger Binding="{Binding InputDisplayName}" Value="Type-C"><Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="HDMI" Command="{Binding SwitchToHdmiCommand}" Margin="8,0,0,0" IsEnabled="{Binding CanSwitchToHdmi}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource InputSourceButton}"><Style.Triggers><DataTrigger Binding="{Binding InputDisplayName}" Value="HDMI"><Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
    <StackPanel Grid.Row="3"><TextBlock Text="Windows 投影" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding ProjectionModes}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Title}" Command="{Binding ApplyCommand}" Height="36" Margin="0,0,8,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
      </StackPanel>
      <StackPanel>
        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ActiveSection}" Value="Sharing"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <TextBlock Text="剪贴板与文件共享" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
        <TextBlock Text="只有本程序运行时才共享，关掉软件就停止。两台电脑都装同一个程序。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Border Background="{StaticResource SurfaceSecondaryBrush}" CornerRadius="{StaticResource Radius6}" Padding="12,10" Margin="0,0,0,14">
          <StackPanel>
            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="本机名称" Style="{StaticResource CaptionText}"/><TextBlock Grid.Column="1" Text="{Binding PeerLocalName, Mode=OneWay}" Style="{StaticResource BodyText}" HorizontalAlignment="Right"/></Grid>
            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="本机地址" Style="{StaticResource CaptionText}"/><TextBlock Grid.Column="1" Text="{Binding LocalIpAddressText, Mode=OneWay}" Style="{StaticResource BodyText}" HorizontalAlignment="Right"/></Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="连接状态" Style="{StaticResource CaptionText}"/><TextBlock Grid.Column="1" Text="{Binding PeerStatusText}" Style="{StaticResource BodyText}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="300" TextAlignment="Right"/></Grid>
          </StackPanel>
        </Border>
        <Button Content="断开连接" Command="{Binding DisconnectPeerCommand}">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource CompactButton}"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Margin" Value="0,0,0,14"/><Style.Triggers><DataTrigger Binding="{Binding IsPeerConnected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
        </Button>
        <StackPanel Margin="0,0,0,16">
          <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsPeerConnected}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
          <TextBlock Text="让对方连接我" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
          <Button Content="生成配对码" Command="{Binding GeneratePairingCodeCommand}" HorizontalAlignment="Left">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource CompactButton}"><Setter Property="HorizontalAlignment" Value="Left"/><Style.Triggers><DataTrigger Binding="{Binding IsPairingCodeShown}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
          </Button>
          <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="{StaticResource Radius6}" Padding="12,10">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPairingCodeShown}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0"><TextBlock Text="{Binding LocalPairingCode}" FontSize="30" FontWeight="SemiBold" FontFamily="Global Monospace" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding PairingCountdownText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/></StackPanel>
              <Button Grid.Column="1" Content="取消" Command="{Binding CancelPairingCodeCommand}" Style="{StaticResource CompactButton}" VerticalAlignment="Top"/>
            </Grid>
          </Border>
          <TextBlock Text="对方在他自己的“我连接对方”里填上面这个本机地址和配对码。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
          <TextBlock Text="我连接对方" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
          <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="对端地址" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Style="{StaticResource FieldTextBox}" Text="{Binding PeerHost, UpdateSourceTrigger=PropertyChanged}"/>
          </Grid>
          <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="对方屏幕上的 6 位配对码" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Style="{StaticResource FieldTextBox}" MaxLength="6" HorizontalAlignment="Left" Width="110" Text="{Binding PeerCode, UpdateSourceTrigger=PropertyChanged}"/>
          </Grid>
          <Button Content="连接" Command="{Binding ConnectPeerCommand}" IsEnabled="{Binding CanConnectPeer}" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Width="88"/>
          <TextBlock Text="{Binding PeerConnectError}">
            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ErrorText}"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,8,0,0"/><Style.Triggers><DataTrigger Binding="{Binding ShowConnectError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
        </StackPanel>
        <TextBlock Text="接收设置" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
        <CheckBox Content="收到文件时自动接收，不再询问" IsChecked="{Binding AutoAcceptFiles}" Margin="0,0,0,10"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="文件保存到" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius6}" Padding="8,6" MinHeight="32" VerticalAlignment="Center"><TextBlock Text="{Binding ReceiveDirectory, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ReceiveDirectory}" Style="{StaticResource BodyText}" VerticalAlignment="Center"/></Border>
          <Button Grid.Column="2" Content="选择文件夹" Click="ChooseReceiveDirectory_Click" Style="{StaticResource CompactButton}" Margin="8,0,0,0"/>
        </Grid>
        <TextBlock Text="在别的电脑上复制文件，收到的文件就落在这个文件夹里。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel>
      <StackPanel>
        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ActiveSection}" Value="KeyboardMouse"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <TextBlock Text="键鼠共享" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
        <TextBlock Text="这个功能还在开发中，当前版本只能共享剪贴板和文件。" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
