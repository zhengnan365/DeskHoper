<Window x:Class="MonitorSwitch.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DeskHoper" Width="516" Height="708" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}">
  <Window.Resources><Style x:Key="NavTab" TargetType="Button"><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="2,7"/><Setter Property="Margin" Value="0,0,28,0"/><Setter Property="MinHeight" Value="36"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid Background="Transparent"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="2"/></Grid.RowDefinitions><ContentPresenter Grid.Row="0" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/><Border Grid.Row="1" CornerRadius="1,1,0,0" Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style><CollectionViewSource x:Key="ExternalMonitorsView" Source="{Binding Monitors}" Filter="ExternalMonitorFilter"/></Window.Resources>
  <Grid Margin="16,24,16,24" HorizontalAlignment="Stretch">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,18" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="DeskHoper" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding DisplayStatusText, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="240"/></Grid>
    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,15">
      <StackPanel Orientation="Horizontal">
        <Button Content="屏幕切换" Command="{Binding SelectSectionCommand}" CommandParameter="ScreenSwitch"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavTab}"><Style.Triggers><DataTrigger Binding="{Binding ActiveSection}" Value="ScreenSwitch"><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Tag" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
        <Button Content="文件共享" Command="{Binding SelectSectionCommand}" CommandParameter="Sharing"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavTab}"><Style.Triggers><DataTrigger Binding="{Binding ActiveSection}" Value="Sharing"><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Tag" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
        <Button Content="键鼠共享" Command="{Binding SelectSectionCommand}" CommandParameter="KeyboardMouse"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavTab}"><Style.Triggers><DataTrigger Binding="{Binding ActiveSection}" Value="KeyboardMouse"><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Tag" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
      <StackPanel>
        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ActiveSection}" Value="ScreenSwitch"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="快速切换" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
      <ItemsControl ItemsSource="{Binding Profiles}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
          <Border Style="{StaticResource ProfileCard}" Height="84" Margin="0,0,8,0">
            <Grid VerticalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" Style="{StaticResource ProfileTitle}" ToolTip="双击编辑输入源和投影模式" MouseLeftButtonDown="ProfileName_MouseLeftButtonDown"/><Ellipse Width="10" Height="10" Fill="{StaticResource SuccessBrush}" Margin="8,0,0,0" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse></StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding ConnectionSummary}" Style="{StaticResource SecondaryText}"/></StackPanel>
              <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Content="切换" Command="{Binding SwitchCommand}" Style="{StaticResource ProfileActionButton}" Width="76" Height="36" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>        <StackPanel Grid.Row="2" Margin="0,0,0,13"><TextBlock Text="投影模式" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding ProjectionModes}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Title}" Command="{Binding ApplyCommand}" Height="36" Margin="0,0,8,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
    <StackPanel Grid.Row="3"><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="显示器控制" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="刷新" Command="{Binding RefreshMonitorsCommand}" Style="{StaticResource CompactButton}" Width="48" Height="30" Margin="16,0,0,0" VerticalAlignment="Center"/><Button Grid.Column="2" Content="标识" Command="{Binding IdentifyMonitorsCommand}" Style="{StaticResource CompactButton}" Width="48" Height="30" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid><ItemsControl ItemsSource="{Binding Source={StaticResource ExternalMonitorsView}}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource MonitorCard}" Width="460" HorizontalAlignment="Stretch" MinHeight="0" Margin="0,0,0,16" AllowDrop="True" Drop="MonitorCard_Drop"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MouseLeftButtonDown="MonitorName_MouseLeftButtonDown" PreviewMouseMove="MonitorTitle_PreviewMouseMove"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}"><Setter Property="Text" Value="内置显示器"/><Style.Triggers><DataTrigger Binding="{Binding IsDdcSupported}" Value="True"><Setter Property="Text" Value="{Binding DisplayTitle}"/></DataTrigger><DataTrigger Binding="{Binding IsEditingName}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBox Grid.Column="0" Text="{Binding EditableName, UpdateSourceTrigger=PropertyChanged}" KeyDown="MonitorNameEditor_KeyDown" LostFocus="MonitorNameEditor_LostFocus"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource InlineRenameTextBox}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEditingName}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox><TextBlock Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}"><Setter Property="Text" Value="DDC不可用"/><Style.Triggers><DataTrigger Binding="{Binding IsDdcSupported}" Value="True"><Setter Property="Text" Value="DDC可用"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><StackPanel Grid.Column="2" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsEditingName}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Button Content="✓" Command="{Binding CommitRenameCommand}" Style="{StaticResource InlineRenameConfirmButton}"/><Button Content="×" Command="{Binding CancelRenameCommand}" Style="{StaticResource InlineRenameCancelButton}" Margin="4,0,0,0"/></StackPanel><Border Grid.Column="3" Width="30" Height="30" Background="{StaticResource AccentSoftBrush}" CornerRadius="8" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayNumber}" Style="{StaticResource CaptionText}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid><Grid Grid.Row="1" Margin="0,4,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}"><Setter Property="Text" Value="{Binding DisplayTitle}"/><Style.Triggers><DataTrigger Binding="{Binding IsDdcSupported}" Value="True"><Setter Property="Text" Value="{Binding ModelSubtitle}"/></DataTrigger><DataTrigger Binding="{Binding ModelSubtitle}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Grid.Column="1" Text="当前输入源" Style="{StaticResource SecondaryText}"/><TextBlock Grid.Column="2" Margin="10,0,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}"><Setter Property="Text" Value="系统内置"/><Style.Triggers><DataTrigger Binding="{Binding IsDdcSupported}" Value="True"><Setter Property="Text" Value="{Binding InputDisplayName}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><StackPanel Grid.Row="3" Orientation="Horizontal" Visibility="Visible"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsDdcSupported}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Button Content="学习输入源" Click="LearnInput_Click" Style="{StaticResource LearnButton}" Width="108" Height="34"/><Button Content="DP" Command="{Binding SwitchToDisplayPortCommand}" Margin="8,0,0,0" IsEnabled="{Binding CanSwitchToDisplayPort}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource InputSourceButton}"><Style.Triggers><DataTrigger Binding="{Binding InputDisplayName}" Value="DisplayPort"><Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="Type-C" Command="{Binding SwitchToUsbCCommand}" Margin="8,0,0,0" IsEnabled="{Binding CanSwitchToUsbC}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource InputSourceButton}"><Style.Triggers><DataTrigger Binding="{Binding InputDisplayName}" Value="Type-C"><Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="HDMI" Command="{Binding SwitchToHdmiCommand}" Margin="8,0,0,0" IsEnabled="{Binding CanSwitchToHdmi}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource InputSourceButton}"><Style.Triggers><DataTrigger Binding="{Binding InputDisplayName}" Value="HDMI"><Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
      </StackPanel>
      <StackPanel>
        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ActiveSection}" Value="Sharing"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="共享状态" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="剪贴板自动同步，文件拖放发送" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <Border Style="{StaticResource SectionCard}">
          <StackPanel>
            <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="本机名称" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Grid Grid.Column="1">
                <TextBlock Text="{Binding PeerLocalName, Mode=OneWay}" MouseLeftButtonDown="LocalName_MouseLeftButtonDown"><TextBlock.ContextMenu><ContextMenu><MenuItem Header="重命名本机" Click="LocalNameRename_Click"/></ContextMenu></TextBlock.ContextMenu><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Style.Triggers><DataTrigger Binding="{Binding IsEditingLocalName}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                <TextBox Text="{Binding EditableLocalName, UpdateSourceTrigger=PropertyChanged}" KeyDown="LocalNameEditor_KeyDown" LostFocus="LocalNameEditor_LostFocus"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource FieldTextBox}"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="MinHeight" Value="26"/><Setter Property="Padding" Value="5,1"/><Style.Triggers><DataTrigger Binding="{Binding IsEditingLocalName}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
              </Grid>
              <TextBlock Grid.Column="2" Text="本机地址" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="14,0,8,0"/>
              <TextBlock Grid.Column="3" Text="{Binding LocalIpAddressText, Mode=OneWay}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="连接状态" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="1" Text="{Binding PeerStatusText}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding PeerStatusDetail}"/>
              <Button Grid.Column="2" Content="断开" Command="{Binding DisconnectPeerCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource CompactButton}"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Padding" Value="8,3"/><Setter Property="MinHeight" Value="26"/><Setter Property="Margin" Value="8,0,0,0"/><Style.Triggers><DataTrigger Binding="{Binding IsPeerConnected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            </Grid>
          </StackPanel>
        </Border>
        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="传文件" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
          <CheckBox Grid.Column="2" Content="自动接收，不再询问" IsChecked="{Binding AutoAcceptFiles}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <Border Style="{StaticResource SectionCard}">
          <StackPanel>
            <Border AllowDrop="True" DragOver="SendFiles_DragOver" Drop="SendFiles_Drop" Background="{StaticResource SurfaceSecondaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5" CornerRadius="{StaticResource Radius6}" Padding="16,14" Margin="0,0,0,10">
              <Border.Style><Style TargetType="Border"><Setter Property="MinHeight" Value="72"/><Style.Triggers><DataTrigger Binding="{Binding IsPeerConnected}" Value="True"><Setter Property="MinHeight" Value="280"/></DataTrigger></Style.Triggers></Style></Border.Style>
              <TextBlock HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}"><Setter Property="FontSize" Value="14"/><Setter Property="Text" Value="把文件拖到这里，发给对面"/><Style.Triggers><DataTrigger Binding="{Binding IsPeerConnected}" Value="False"><Setter Property="Text" Value="连上对端后可以拖文件进来"/><Setter Property="Opacity" Value="0.5"/></DataTrigger><DataTrigger Binding="{Binding IsReceivingFiles}" Value="True"><Setter Property="Text" Value="{Binding ReceiveProgressText}"/><Setter Property="Opacity" Value="1"/></DataTrigger><DataTrigger Binding="{Binding IsSendingFiles}" Value="True"><Setter Property="Text" Value="{Binding SendProgressText}"/><Setter Property="Opacity" Value="1"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </Border>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="文件保存到" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Border Grid.Column="1" Background="{StaticResource SurfaceSecondaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius6}" Padding="8,6" MinHeight="32" VerticalAlignment="Center"><TextBlock Text="{Binding ReceiveDirectory, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ReceiveDirectory}" Style="{StaticResource BodyText}" VerticalAlignment="Center"/></Border>
              <Button Grid.Column="2" Content="选择文件夹" Click="ChooseReceiveDirectory_Click" Style="{StaticResource CompactButton}" Margin="8,0,0,0"/>
            </Grid>
          </StackPanel>
        </Border>
        <StackPanel>
          <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsPeerConnected}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
          <TextBlock Text="配对" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
          <Border Style="{StaticResource SectionCard}">
            <StackPanel>
            <Grid MinHeight="36"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="对方连接我" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Content="生成配对码" Command="{Binding GeneratePairingCodeCommand}" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource CompactButton}"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Padding" Value="10,4"/><Setter Property="MinHeight" Value="28"/><Style.Triggers><DataTrigger Binding="{Binding IsPairingCodeShown}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
              </Button>
              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Orientation" Value="Horizontal"/><Setter Property="HorizontalAlignment" Value="Right"/><Style.Triggers><DataTrigger Binding="{Binding IsPairingCodeShown}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="{StaticResource Radius6}" Padding="10,3"><StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding LocalPairingCode}" FontSize="22" FontWeight="SemiBold" FontFamily="Global Monospace" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding PairingCountdownText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel></Border>
                <Button Content="取消" Command="{Binding CancelPairingCodeCommand}" Style="{StaticResource CompactButton}" Padding="10,4" MinHeight="28" Margin="8,0,0,0"/>
              </StackPanel>
            </Grid>
              <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8"/>
              <TextBlock Text="我连接对方" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
              <Grid>
                <ItemsControl ItemsSource="{Binding DiscoveredPeers}"><ItemsControl.ItemTemplate><DataTemplate>
                  <Button Command="{Binding DataContext.SelectPeerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource PeerRowButton}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Address}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid></Button>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <Border Background="{StaticResource SurfaceSecondaryBrush}" CornerRadius="{StaticResource Radius6}" Padding="10,6" Margin="0,0,0,4" MinHeight="0">
                  <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasDiscoveredPeers}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                  <TextBlock Text="局域网未发现配对设备" Style="{StaticResource SecondaryText}" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="名称或 IP" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Style="{StaticResource FieldTextBox}" Text="{Binding PeerHost, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,8,0"/>
                <TextBlock Grid.Column="2" Text="配对码" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="3" Style="{StaticResource FieldTextBox}" MaxLength="6" Width="96" Text="{Binding PeerCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                <Button Grid.Column="4" Content="连接" Command="{Binding ConnectPeerCommand}" IsEnabled="{Binding CanConnectPeer}" Style="{StaticResource AccentButton}" Width="76"/>
              </Grid>
              <TextBlock Text="{Binding PeerConnectError}">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ErrorText}"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,6,0,0"/><Style.Triggers><DataTrigger Binding="{Binding ShowConnectError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
      <StackPanel>
        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ActiveSection}" Value="KeyboardMouse"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <TextBlock Text="键鼠共享" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
        <Border Style="{StaticResource SectionCard}">
          <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="当前状态" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBlock Grid.Column="1" Text="{Binding InputStatusText}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <TextBlock Text="{Binding InputErrorText}">
              <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ErrorText}"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,6,0,0"/><Style.Triggers><DataTrigger Binding="{Binding ShowInputError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SectionCard}">
          <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="转发情况" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <TextBlock Grid.Column="1" Text="{Binding InputStatsText}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <CheckBox Content="共享键盘" IsChecked="{Binding ShareKeyboard}" VerticalAlignment="Center"/>
              <CheckBox Content="共享鼠标" IsChecked="{Binding ShareMouse}" Margin="28,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding InputModes}"><ItemsControl.ItemTemplate><DataTemplate>
          <RadioButton GroupName="InputMode" IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource ModeCard}">
            <Grid VerticalAlignment="Center">
              <Grid Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" MouseLeftButtonDown="InputModeName_MouseLeftButtonDown"><TextBlock.ContextMenu><ContextMenu><MenuItem Header="重命名这张卡片" Click="InputModeRename_Click"/></ContextMenu></TextBlock.ContextMenu><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ProfileTitle}"><Setter Property="VerticalAlignment" Value="Center"/><Style.Triggers><DataTrigger Binding="{Binding IsEditingName}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                <TextBox Width="190" HorizontalAlignment="Left" FontSize="16" Text="{Binding EditableName, UpdateSourceTrigger=PropertyChanged}" KeyDown="InputModeNameEditor_KeyDown" LostFocus="InputModeNameEditor_LostFocus"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource FieldTextBox}"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="MinHeight" Value="32"/><Style.Triggers><DataTrigger Binding="{Binding IsEditingName}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
              </Grid>
            </Grid>
          </RadioButton>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
