<Window x:Class="MonitorSwitch.Views.PeerPairingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{Binding Title}" Width="420" SizeToContent="Height" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
  <StackPanel Margin="24">
    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" Margin="0,0,0,16"/>

    <StackPanel>
      <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsConnectMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="对端 IP 或计算机名" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InlineRenameTextBox}" Height="34"/>
      </Grid>
      <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="对端显示的 6 位配对码" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" Style="{StaticResource InlineRenameTextBox}" Height="34"/>
      </Grid>
      <TextBlock Text="两台电脑需要在同一个局域网。第一次连接时对方 Windows 防火墙会弹出提示，请选择允许访问。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,18"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" IsCancel="True" Style="{StaticResource CompactButton}" Margin="0,0,8,0"/>
        <Button Content="连接" IsDefault="True" IsEnabled="{Binding CanConnect}" Style="{StaticResource ProfileActionButton}" Width="88" Click="Connect_Click"/>
      </StackPanel>
    </StackPanel>

    <StackPanel>
      <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsConnectMode}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{Binding LocalPairingCode}" FontSize="40" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
      <TextBlock Text="在另一台电脑点“连接对端”，输入上面这个配对码。配对码 5 分钟内有效，只有输对才能连上。" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,20"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Content="关闭" IsCancel="True" Style="{StaticResource CompactButton}" Margin="0,0,8,0"/>
        <Button Content="取消这个配对码" Style="{StaticResource GhostButton}" Click="CancelCode_Click"/>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</Window>
