<Window x:Class="MonitorSwitch.Views.FileReceiveWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="接收文件" Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
  <StackPanel Margin="24">
    <TextBlock Text="对端要发送文件" Style="{StaticResource PageTitle}" Margin="0,0,0,4"/>
    <TextBlock Text="{Binding CountLine}" Style="{StaticResource SecondaryText}"/>
    <TextBlock Text="{Binding Total}" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <Border Background="{StaticResource SurfaceSecondaryBrush}" CornerRadius="{StaticResource Radius6}" Padding="12,10" Margin="0,0,0,12" MaxHeight="200">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Lines}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </Border>
    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,14"><Run Text="保存到："/><Run Text="{Binding ReceiveDirectory, Mode=OneWay}"/></TextBlock>
    <CheckBox Content="以后自动接收，不再询问" IsChecked="{Binding AutoAcceptChosen}" Margin="0,0,0,16">
      <CheckBox.Style><Style TargetType="CheckBox"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding AutoAcceptEnabled}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></CheckBox.Style>
    </CheckBox>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="拒绝" IsCancel="True" Style="{StaticResource CompactButton}" Margin="0,0,8,0"/>
      <Button Content="接收" IsDefault="True" Style="{StaticResource ProfileActionButton}" Width="88" Click="Accept_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
