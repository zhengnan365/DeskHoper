<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>DeskHoper</AssemblyName>
    <Product>DeskHoper</Product>
    <Title>DeskHoper</Title>
    <Version>2.2.0</Version>
    <AssemblyVersion>2.2.0.0</AssemblyVersion>
    <FileVersion>2.2.0.0</FileVersion>
    <InformationalVersion>2.2.0</InformationalVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 托盘图标用 WinForms 的 NotifyIcon：自己 P/Invoke Shell_NotifyIcon 要带一块消息窗口和结构体，不值。
         实测多带 WinForms 程序集，自包含包体积只涨几 MB。 -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>UI\Assets\DeskHoper.ico</ApplicationIcon>
    <!-- 运行时包会带上 13 种语言的资源目录，实测 26MB；界面只有中文，保留 zh-Hans 可省 14.4MB -->
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <!-- 开 WinForms 会顺带把 System.Windows.Forms / System.Drawing 塞成全局 using，
         和 WPF 的 Point / DragEventArgs / MouseEventArgs 全部撞名。托盘代码自己显式 import，这里把全局的撤掉。 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="MonitorSwitch.Tests\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Page Remove="UI\App.xaml" />
    <ApplicationDefinition Include="UI\App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- 让回归测试能直接驱动 internal 的接收落盘状态机（恶意文件名那条用例必须能测） -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>MonitorSwitch.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
